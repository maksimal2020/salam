{
  "name": "migrant-guide",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["server", "web"],
  "scripts": {
    "db:migrate": "npm -w server run migrate",
    "content:import": "npm -w server run content:import",
    "content:check": "npm -w server run content:check",
    "coverage": "npm -w server run coverage",
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "build": "npm -w web run build && npm -w server run build",
    "start": "npm -w server run start",
    "test": "npm -w server run test",
    "e2e": "node e2e/run.mjs"
  }
}
