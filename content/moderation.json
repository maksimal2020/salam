{
  "forbidden": [
    {
      "id": "sell_documents",
      "patterns": [
        "прода\\w*\\s+(паспорт|патент|документ|справк|медкниж|инн|снилс|миграционн)",
        "(куплю|купить|покупка)\\s+(паспорт|патент|документ|регистрац|прописк)",
        "(патент|справк\\w*|медкниж\\w*|документ\\w*)\\s+без\\s+(экзамен|анализ|осмотр|прохожден|очеред|проверк|присутств)",
        "(левы\\w|поддельн\\w|липов\\w)\\s+(документ|справк|патент|паспорт)",
        "(сделаю|оформлю|достану)\\s+(патент|паспорт|справк|медкниж)\\w*\\s+(за\\s+деньги|без|быстро\\s+за)",
        "hujjat\\w*\\s+sot",
        "patent\\w*\\s+sot",
        "soxta\\s+(hujjat|patent|maʼlumotnoma|ma.lumotnoma)",
        "ҳуҷҷат\\w*\\s+(мефурӯш|мефуруш)",
        "патент\\w*\\s+(мефурӯш|мефуруш)",
        "документ\\w*\\s+сат(ам|ып)",
        "патент\\w*\\s+сат(ам|ып)",
        "құжат\\w*\\s+сат(амын|у)",
        "патент\\w*\\s+сат(амын|у)"
      ]
    },
    {
      "id": "fake_registration",
      "patterns": [
        "фиктивн\\w*",
        "(регистрац|прописк|миграционн\\w+\\s+учёт|миграционн\\w+\\s+учет)\\w*\\s+без\\s+(проживан|жилья|вселен)",
        "без\\s+(проживани|вселени)\\w*.{0,30}(регистрац|прописк)",
        "(купить|продам|продаю|оформлю|сделаю)\\s+(регистрац|прописк)",
        "(регистрац|прописк)\\w*\\s+за\\s+(деньги|плату|\\d)",
        "регистрац\\w*\\s+для\\s+вида",
        "soxta\\s+(ro.yxat|registratsiya|propiska|prописка)",
        "ro.yxatga\\s+qo.yish\\s+yashamasdan",
        "қайди\\s+сохта",
        "сохта\\s+(қайд|ба\\s+қайд)",
        "жалган\\s+(катто|каттоо|прописка|регистрация)",
        "жалған\\s+(тіркеу|тіркелу|прописка|регистрация)"
      ]
    },
    {
      "id": "prepayment_job",
      "patterns": [
        "(предоплат|залог|депозит|взнос|оплат[аиу])\\w*\\s+(за\\s+)?(трудоустройств|устройств\\w*\\s+на\\s+работ|вакан|рабочее\\s+место|место\\s+работы)",
        "(плат(и|ите)|внес(и|ите)|перевед(и|ите))\\s+[^.]{0,50}(за|для)\\s+(трудоустройств|оформлени\\w*\\s+на\\s+работ|вакан|работ[ауы])",
        "работа\\s+(после|за)\\s+(предоплат|оплат)",
        "(стоимость|цена)\\s+трудоустройства",
        "трудоустройств\\w*\\s+(платно|за\\s+деньги|за\\s+плату)",
        "(залог|депозит)\\s+за\\s+(спецодежд|форм|инструмент)",
        "ishga\\s+joylash\\w*\\s+(pullik|uchun\\s+to.lov)",
        "oldindan\\s+to.lov\\w*[^.]{0,40}\\bish\\b",
        "пешпардохт\\w*[^.]{0,40}\\bкор\\b",
        "барои\\s+кор\\s+пул",
        "алдын\\s+ала\\s+төлөм\\w*[^.]{0,40}жумуш",
        "жумуш\\w*\\s+үчүн\\s+акча\\s+төлө",
        "алдын\\s+ала\\s+төлем\\w*[^.]{0,40}жұмыс",
        "жұмыс\\w*\\s+үшін\\s+ақша\\s+төле"
      ]
    }
  ],
  "passport": [
    "(?<!\\d)\\d{4}\\s?\\d{6}(?!\\d)",
    "(?<![A-Za-z0-9])[A-Z]{1,2}\\s?\\d{7}(?![A-Za-z0-9])",
    "(паспорт|passport|pasport|шиноснома|төлқұжат|паспортун)\\w*\\s*[№#:]?\\s*[A-ZА-Я]{0,2}\\s*\\d{6,}"
  ],
  "contact": [
    "[\\w.+-]+@[\\w-]+\\.[\\w.-]+",
    "(?:\\+?\\d[\\s\\-().]*){10,}",
    "t\\.me/",
    "wa\\.me/",
    "whatsapp\\.com",
    "(?<![\\w@])@[A-Za-z][A-Za-z0-9_]{4,}"
  ],
  "premoderate_categories": [
    "work"
  ],
  "max_duration_days": 30,
  "default_duration_days": 14
}
